package-as: Luckys_Wardrobe

ignore:
  - tests
  - images
  - tools

move-folders:
  Luckys_Wardrobe/src: Luckys_Wardrobe

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  src/Libs/LuckysUtils:
    url: https://github.com/LuckyPhilDev/LuckyUtils
    tag: latest

enable-nolib-creation: no
